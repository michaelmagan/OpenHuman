# Copy to Tools/release/release.env (gitignored) so make-dmg.sh knows your names without typing them each time.
# Names and the provisioning profile's path only: never a password, an API key or a .p8 path. The ":=" form keeps a value already set in the environment.

# The profile name you chose in the one-time `xcrun notarytool store-credentials` step (RELEASE-HOWTO, 'Signing setup').
: "${OH_NOTARY_PROFILE:=openhuman-notary}"

# Only needed when your keychain holds more than one "Developer ID Application" identity: its full name, or the
# 40-character hash that `security find-identity -v -p codesigning` prints next to it.
# : "${OH_SIGN_IDENTITY:=Developer ID Application: Your Name (ABCDE12345)}"

# The Developer ID provisioning profile you downloaded for the app's App ID (RELEASE-HOWTO, 'iCloud entitlements').
# Keep it outside the repository. Not needed for --unsigned or --no-icloud builds.
# : "${OH_PROVISIONING_PROFILE:=$HOME/Documents/OpenHuman_Mail_Developer_ID.provisionprofile}"

# Sign and notarize from a separate keychain that SSH logins and scripts can unlock without prompts. Tools/signing/setup.sh
# writes these, with OH_SIGN_IDENTITY and OH_NOTARY_PROFILE, to ~/.config/openhuman/release.env, which make-dmg.sh reads
# before this file (docs/release/LOCAL-SIGNING.md). Unset or empty: sign from the login keychain.
# : "${OH_SIGNING_KEYCHAIN=$HOME/Library/Keychains/openhuman-signing.keychain-db}"
# : "${OH_SIGNING_KEYCHAIN_PASSWORD_FILE=$HOME/.config/openhuman/signing-keychain.password}"

# For make-dmg.sh --enable-updates only (docs/release/SPARKLE.md): the address of the update feed and the public key that
# `generate_keys -p` prints. Public values; the private key stays in your keychain.
# : "${OH_UPDATE_FEED_URL:=https://updates.example.test/appcast.xml}"
# : "${OH_SPARKLE_PUBLIC_KEY:=<the public key generate_keys printed>}"
