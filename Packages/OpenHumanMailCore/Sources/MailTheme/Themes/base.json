{
  "format": "openhuman-theme",
  "formatVersion": 1,
  "id": "openhuman.base",
  "name": "Base",
  "appearance": "any",
  "extends": null,
  "typography": {
    "family": { "ui": "system", "reader": "system", "mono": "system-mono" },
    "styles": {
      "display.lg":    { "size": 30, "lineHeight": 36, "weight": 500, "trackingEm": -0.02 },
      "display":       { "size": 26, "lineHeight": 32, "weight": 400, "trackingEm": -0.015 },
      "subject":       { "size": 22, "lineHeight": 28, "weight": 500, "trackingEm": -0.01 },
      "title":         { "size": 20, "lineHeight": 26, "weight": 500, "trackingEm": -0.01 },
      "headline":      { "size": 15, "lineHeight": 20, "weight": 600, "trackingEm": 0 },
      "tab":           { "size": 18, "lineHeight": 24, "weight": 400, "trackingEm": 0 },
      "tab.active":    { "size": 19, "lineHeight": 24, "weight": 400, "trackingEm": 0 },
      "body":          { "size": 13, "lineHeight": 18, "weight": 400, "trackingEm": 0 },
      "body.strong":   { "size": 13, "lineHeight": 18, "weight": 600, "trackingEm": 0 },
      "palette.input": { "size": 18, "lineHeight": 24, "weight": 400, "trackingEm": 0, "family": "mono" },
      "reader":        { "size": 14, "lineHeight": 22, "weight": 400, "trackingEm": 0 },
      "meta":          { "size": 12, "lineHeight": 16, "weight": 400, "trackingEm": 0, "numerals": "tabular" },
      "label":         { "size": 12, "lineHeight": 16, "weight": 500, "trackingEm": 0.005 },
      "caption":       { "size": 11, "lineHeight": 14, "weight": 500, "trackingEm": 0.01, "numerals": "tabular" },
      "keycap":        { "size": 11, "lineHeight": 14, "weight": 500, "trackingEm": 0 },
      "mono":          { "size": 12, "lineHeight": 18, "weight": 400, "trackingEm": 0, "family": "mono" },
      "tabCount":      { "size": 13, "lineHeight": 16, "weight": 400, "trackingEm": 0, "numerals": "tabular" },
      "palette.row":   { "size": 14, "lineHeight": 20, "weight": 400, "trackingEm": 0, "family": "mono" }
    }
  },
  "space":  { "0": 0, "1": 2, "2": 4, "3": 8, "4": 12, "5": 16, "6": 20, "7": 24, "8": 32, "9": 40, "10": 48, "11": 64 },
  "radius": { "xs": 3, "sm": 4, "md": 6, "lg": 8, "xl": 12, "pill": 999 },
  "border": { "hairline": 1, "control": 1, "focus": 2, "focusOffset": 2, "cursorBar": 2 },
  "density": {
    "compact":     { "row": 32, "splitRow": 48 },
    "default":     { "row": 40, "splitRow": 52 },
    "comfortable": { "row": 48, "splitRow": 60 }
  },
  "motion": {
    "instant":    { "duration": 0 },
    "enter.fast": { "duration": 100, "easing": "cubic-bezier(0.2,0,0,1)" },
    "exit.fast":  { "duration": 80,  "easing": "cubic-bezier(0.4,0,1,1)" },
    "enter.base": { "duration": 160, "easing": "cubic-bezier(0.2,0,0,1)" },
    "exit.base":  { "duration": 120, "easing": "cubic-bezier(0.4,0,1,1)" },
    "reveal":     { "duration": 80,  "easing": "linear" },
    "slow":       { "duration": 240, "easing": "cubic-bezier(0.2,0,0,1)" },
    "progress":   { "duration": 1200, "easing": "linear" },
    "tooltipDelay": 500, "tooltipWarm": 1500,
    "spinnerDelay": 150, "spinnerMinVisible": 400,
    "toastAction": 6000, "toastInfo": 4000, "toastError": 10000, "toastBrief": 2000, "toastResume": 1500,
    "bannerIdle": 300, "launchQuiet": 1000, "reducedFade": 80, "footerNotice": 2000, "sequenceReveal": 500
  },
  "components": {
    "window":   { "minWidth": 960, "minHeight": 600, "defaultWidth": 1360, "defaultHeight": 860 },
    "toolbar":  { "height": 52, "bg": "{bg.window}", "divider": "{border.hairline}", "paddingX": 24, "iconSize": 18 },
    "footer":   { "height": 28, "bg": "{bg.window}", "divider": "{border.hairline}" },
    "tab":      { "text": "{text.tertiary}", "textActive": "{text.primary}", "count": "{text.tertiary}", "gap": 20, "countGap": 4 },
    "row": {
      "paddingX": 24, "dotGutter": 16, "senderMin": 160, "senderMax": 240, "senderPct": 0.22,
      "indicatorWidth": 40, "dateWidth": 72, "columnGap": 16,
      "bgHover": "{bg.row.hover}", "bgCursor": "{accent.subtle}", "bgChecked": "{accent.subtle}",
      "cursorBar": "{accent.ring}", "cursorBarWidth": 3, "cursorInsetX": 6, "cursorInsetY": 2, "cursorRadius": "{radius.md}",
      "unreadDot": "#1F7FC8", "unreadDotSize": 6,
      "sender": "{text.primary}", "subject": "{text.primary}", "snippet": "{text.tertiary}",
      "date": "{text.tertiary}", "dateUnread": "{text.primary}", "draft": "{text.success}",
      "snoozed": "{text.warning}", "groupHeader": "{text.tertiary}", "groupHeaderHeight": 32,
      "unreadWeight": 400, "chipBg": "{bg.sunken}", "chipText": "{text.secondary}", "chipRadius": "{radius.sm}"
    },
    "labelChip": {
      "roseBg": "#FBE4F0", "roseText": "#8C1D5A", "coralBg": "#FDE4DA", "coralText": "#93300F",
      "tangerineBg": "#FDEBD5", "tangerineText": "#84470A", "amberBg": "#FBF1C7", "amberText": "#6B4E00",
      "greenBg": "#E3F2DD", "greenText": "#2E5E1E", "tealBg": "#DBF1EE", "tealText": "#1B5C55",
      "skyBg": "#E0ECFB", "skyText": "#1E4F8F", "lavenderBg": "#ECE7FC", "lavenderText": "#5032A8"
    },
    "swipe":    { "done": "#1A7340", "snooze": "#8F4A00", "trash": "#B42318", "text": "#FFFFFF" },
    "sidebar":  { "width": 300, "minWidth": 260, "maxWidth": 360, "bg": "{bg.sidebar}" },
    "labelSidebar": { "width": 220, "rowHeight": 28, "insetX": 8, "radius": "{radius.md}",
                  "bgSelected": "{bg.row.selected}", "bgHover": "{bg.row.hover}", "bar": "{accent.ring}",
                  "iconSelected": "{accent.text}", "count": "{text.secondary}", "header": "{text.secondary}" },
    "thread":   { "maxWidth": 760, "paddingX": 40, "collapsedRow": 40, "messageGap": 16,
                  "cardBg": "{bg.card}", "cardShadow": "{shadow.1}", "focusEdgeWidth": 4,
                  "pillEnterOffset": 6 },
    "avatar":   { "size": 28, "bg": "{bg.sunken}", "text": "{text.secondary}", "ring": "{border.hairline}" },
    "compose":  { "bg": "{bg.card}", "radius": "{radius.lg}", "shadow": "{shadow.2}", "padding": 24, "barHeight": 36, "maxWidth": 760 },
    "token":    { "height": 22, "radius": "{radius.md}", "bg": "{bg.sunken}", "bgSelected": "{accent.subtle}" },
    "palette":  { "width": 680, "top": 96, "inputHeight": 52, "rowHeight": 48, "groupHeight": 28, "footerHeight": 32, "maxResults": 420,
                  "bg": "#1A1A1A", "radius": "{radius.sm}", "shadow": "{shadow.3}",
                  "scopeHeight": 22, "scopeMaxWidth": 220, "scopeBg": "#313131", "scopeText": "#B7B7B7",
                  "scopeRadius": "{radius.pill}", "rowDisabled": "#767676",
                  "text": "#8D8D8D", "textSelected": "#EBEBEB", "band": "#313131", "header": "#B7B7B7", "divider": "#313131",
                  "icon": "#BBBBBB", "keycapBg": "#3C3C3C", "keycapText": "#C8C8C8",
                  "titleHeight": 40, "topRatio": 0.22, "cursorInset": 0 },
    "picker":   { "width": 420, "top": 120, "rowHeight": 48 },
    "popover":  { "bg": "{bg.elevated}", "radius": "{radius.lg}", "shadow": "{shadow.2}", "border": "{border.elevated}", "enterOffset": 4 },
    "modal":    { "width": 400, "radius": "{radius.xl}", "shadow": "{shadow.3}", "padding": 24, "scrim": "{bg.scrim}", "enterScale": 0.97 },
    "toast":    { "height": 40, "minWidth": 280, "maxWidth": 480, "bottom": 24, "bg": "{bg.toast}", "text": "{text.onToast}", "radius": "{radius.lg}",
                  "enterOffset": 8, "exitOffset": 4, "gap": 8, "textSecondary": "{text.onToastSecondary}", "danger": "{text.onToastDanger}",
                  "keycapBg": "{text.onToastSecondary}", "keycapText": "{bg.toast}", "closeSize": 16 },
    "banner":   { "height": 32 },
    "keycap":   { "height": 18, "minWidth": 18, "bg": "{keycap.bg}", "text": "{keycap.text}", "border": "rgba(0,0,0,0)", "radius": "{radius.sm}" },
    "focus":    { "ring": "{accent.ring}", "width": 2, "offset": 2 },
    "chip.ai":  { "height": 28, "bg": "{bg.window}", "bgSelected": "{bg.aiSubtle}", "border": "{border.control}", "borderSelected": "{text.ai}", "radius": "{radius.pill}" },
    "link":     { "text": "{text.link}" },
    "highlight":{ "bg": "{bg.searchHighlight}", "radius": "{radius.xs}" },
    "overlay":  { "enterScale": 0.98, "enterOffset": 4 },
    "skeleton": { "fill": "{bg.sunken}", "pillWidth": 96 }
  },
  "reader": {
    "emailColors": "adaptWhenSafe",
    "maxImageWidth": "100%",
    "quoteBorder": "{border.control}",
    "quoteBarWidth": 2,
    "designedEmailCard": { "bg": "#FFFFFF", "radius": "{radius.lg}", "border": "{border.elevated}" }
  }
}
