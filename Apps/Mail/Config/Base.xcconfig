// Build settings shared by every configuration.
#include "Version.xcconfig"

OH_BUNDLE_ID_PREFIX = dev.openhuman
OH_GIT_COMMIT = unknown

PRODUCT_NAME = OpenHumanMail
PRODUCT_BUNDLE_IDENTIFIER = $(OH_BUNDLE_ID_PREFIX).mail
MACOSX_DEPLOYMENT_TARGET = 26.0
ARCHS = arm64
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
ENABLE_APP_SANDBOX = NO
ENABLE_HARDENED_RUNTIME = NO
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
// Empty, so a build without a provisioning profile launches. Tools/release/make-dmg.sh adds the iCloud entitlements.
OH_ENTITLEMENTS = Entitlements/Mail.entitlements
CURRENT_PROJECT_VERSION = 1
// Empty, so no build checks for updates. Tools/release/make-dmg.sh --enable-updates sets both on its command line for a
// Developer ID build. Never put the values here: "//" in a URL or a base64 key starts a comment in this file.
OH_UPDATE_FEED_URL =
OH_SPARKLE_PUBLIC_KEY =
GENERATE_INFOPLIST_FILE = NO

COMPILATION_CACHE_ENABLE_CACHING = YES
COMPILATION_CACHE_CAS_PATH = $(HOME)/Library/Caches/OpenHuman/compilation-cache

// Local overrides go last so they win over the defaults above (a developer's signing team, identity and bundle id prefix).
#include? "Local.xcconfig"
